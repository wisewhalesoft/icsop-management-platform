%% 與 docs/specs/data-model.md §OJT_SESSION 段落一致。虛線（..）關係＝衍生 join，非實體外鍵；
%% 實線（--）關係＝真實 FK。人類閘門已對 E11 全部 16 題 OQ 裁決完畢（見 open-questions.md §E11）。
%% OJT_SIGNIN 遷移完成後 DOCUMENT_ATTACHMENT 不再有該型別之列（OQ-E11-01=C＋OQ-E11-11=A，完全移除）。
erDiagram
    ICSOP_DOCUMENT ||--o{ DOC_USING_DEPT : "使用部門（既有，原樣不展開子樹）"
    ICSOP_DOCUMENT ||--o{ OJT_SESSION : "場次（FK ON DELETE CASCADE）"
    ICSOP_DOCUMENT ||--o{ DOCUMENT_ATTACHMENT : "ICSOP_PDF（不變）；OJT_SIGNIN 已裁決移除，遷移後不再有此型別之列"
    DOC_USING_DEPT |o..o{ OJT_SESSION : "衍生join：documentId+orgCode值比對，非FK；孤兒/待歸位列不匹配"

    ICSOP_DOCUMENT {
        uuid id PK
        varchar companyCode
        varchar documentNumber
    }
    DOC_USING_DEPT {
        uuid id PK
        uuid documentId FK
        varchar companyCode
        varchar orgCode "複合唯一(documentId,orgCode)"
    }
    OJT_SESSION {
        uuid id PK
        uuid documentId FK "ON DELETE CASCADE"
        varchar companyCode
        varchar orgCode "nullable，NULL=待歸位(OQ-E11-01=C)；非NULL時值比對DOC_USING_DEPT非FK；索引(documentId,orgCode)非唯一"
        datetime orphanedAt "nullable，OQ-E11-02=C軟標記；NULL=使用中或已復活，有值=單位已移除"
        date trainingDate "必填，不可未來日(OQ-E11-09=A)；待歸位列以uploadedAt近似"
        varchar fileName
        varchar blobPath "新場次：documents/{documentId}/ojt/{orgCode}/{uuid}.ext；遷移待歸位列：沿用舊格式，歸位時不搬移"
        varchar contentType
        bigint size "上限50MB(OQ-E11-10=A)"
        varchar uploadedBy
        datetime uploadedAt
    }
    DOCUMENT_ATTACHMENT {
        uuid id PK
        uuid documentId FK
        varchar type "僅ICSOP_PDF；OJT_SIGNIN已裁決移除(OQ-E11-11=A)"
        varchar fileName
        varchar blobPath
    }
