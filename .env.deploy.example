# =============================================================================
# ICSOP — 遠端測試環境部署用 .env 範本（docker compose 於同目錄自動讀取）
# =============================================================================
# 用法：cp .env.deploy.example .env  後填入標示 ← 填 的欄位。
# ⚠ .env 內含機密，已列入 .gitignore，勿 commit。
#
# 目標站台：https://testicsop.hfcfinance.com.tw
#   對外 80/443 由 edge 反向代理獨佔（cdmp-mvp/edge，與 testcdmp 共用同一張
#   *.hfcfinance.com.tw wildcard 憑證），Host 分流後轉進 icsop-frontend。
#   本檔為 ICSOP compose 專用；edge 為獨立 compose，不吃本檔。
# =============================================================================


# -----------------------------------------------------------------------------
# 應用資料庫（外部 MSSQL；本 compose 不含 DB 容器）
# -----------------------------------------------------------------------------
# ⚠ 測試環境連【既有】SOP 庫（已有 schema 與資料）——與 dev 為同一個庫，非隔離環境。
#   意即在測試站上的建檔／刪檔／角色調整，dev 端會看到同一份資料。
# ⚠ 部署主機須網路可達 172.20.202.212:1433（企業內網）。
APP_MSSQL_HOST=172.20.202.212
APP_MSSQL_PORT=1433
APP_MSSQL_DATABASE=SOP
APP_MSSQL_USER=ICSOPT
APP_MSSQL_PASSWORD=                       # ← 填
APP_MSSQL_TRUST_SERVER_CERT=true


# -----------------------------------------------------------------------------
# 上游 HR MSSQL（外部、唯讀）— 組織／人員每日同步與登入時的帳號比對來源
# -----------------------------------------------------------------------------
UPSTREAM_MSSQL_HOST=172.20.202.193
UPSTREAM_MSSQL_PORT=1433
UPSTREAM_MSSQL_DATABASE=ZZIPPROD
UPSTREAM_MSSQL_USER=                      # ← 填
UPSTREAM_MSSQL_PASSWORD=                  # ← 填
UPSTREAM_LINKED_SERVER=APYHFC23
UPSTREAM_REMOTE_DB=HR2
UPSTREAM_TRUST_SERVER_CERT=true
UPSTREAM_CONNECT_TIMEOUT=15


# -----------------------------------------------------------------------------
# Azure AD (Entra ID) OIDC — 公司帳號登入
# -----------------------------------------------------------------------------
# ⚠ 部署前置（Azure Portal，需管理員）：於【同一個】app registration 的
#   Authentication → Web → Redirect URIs 新增下方 URI（逐字一致，含大小寫與無結尾斜線），
#   否則登入會收到 AADSTS50011。dev 的 http://localhost:3000/auth/callback 保留不動，
#   一個註冊可同時掛多組。步驟見 docs/setup/azure-ad-app-registration.md §6。
AZURE_AD_TENANT_ID=4fc63fd2-84fc-48ac-aa7f-a816efde1f5a
AZURE_AD_CLIENT_ID=                       # ← 填（同 dev 之 app registration）
AZURE_AD_CLIENT_SECRET=                   # ← 填（⚠ 到期會導致全系統無法登入，記下到期日）
AZURE_AD_REDIRECT_URI=https://testicsop.hfcfinance.com.tw/auth/callback

# POST_LOGIN_REDIRECT_URL / POST_LOGOUT_REDIRECT_URL：正式部署為同源反代，
# 兩者留空即用預設相對路徑 '/'（落回 SPA）。切勿填絕對網址——絕對轉址會掉 port／走錯 scheme。


# -----------------------------------------------------------------------------
# Session 與反向代理
# -----------------------------------------------------------------------------
# 產生：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠ 未設定則後端以 dev 預設密鑰運行——任何人都能自簽 session token 冒充任意角色。
SESSION_JWT_SECRET=                       # ← 填
# 對外僅 HTTPS → cookie 加 Secure 旗標（dev 走 http://localhost 故預設關閉）。
SESSION_COOKIE_SECURE=true
# 代理層數：edge nginx → frontend nginx → backend ＝ 2。
# 設錯會讓 req.ip 恆為反代位址 → 帳密登入的 IP 節流變成全體共用一個額度。
TRUST_PROXY_HOPS=2


# -----------------------------------------------------------------------------
# Azure Blob Storage — 文件本體（PDF／XLS／附錄）儲存
# -----------------------------------------------------------------------------
# ⚠ 未設定時後端會 fallback 到記憶體 FakeBlobStore：上傳看似成功，容器一重啟檔案全消失。
#   測試環境務必填實體儲存體帳戶。
AZURE_BLOB_CONNECTION_STRING=             # ← 填
AZURE_BLOB_CONTAINER=mid-signed-pdf


# -----------------------------------------------------------------------------
# RAG 向量庫（pgvector 容器）— Phase 3 功能尚未實作，先起著即可
# -----------------------------------------------------------------------------
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=icsop_rag
PGVECTOR_USER=icsop
PGVECTOR_PASSWORD=                        # ← 填（任意強隨機值）


# -----------------------------------------------------------------------------
# 對外 port 綁定（共用主機避免衝突用）
# -----------------------------------------------------------------------------
# 格式同 compose short syntax，可含綁定位址。對外服務一律經 edge，故三者皆只綁 127.0.0.1
# （僅供主機上除錯直連），不對區網開放。
# ⚠ 同一台測試機已有 cdmp：cdmp-api 佔 3000、cdmp-web 佔 5174，故此處錯開。
BACKEND_PUBLISH=127.0.0.1:3100
FRONTEND_PUBLISH=127.0.0.1:5175
PGVECTOR_PUBLISH=127.0.0.1:5433


# -----------------------------------------------------------------------------
# 其他
# -----------------------------------------------------------------------------
# DEV_ADMIN_EMAIL：把該 email 的帳號升為系統管理員。連既有 SOP 庫時已有管理員，留空即可；
# 僅在全新空庫初始化（--profile init）時才需要設定。
# DEV_ADMIN_EMAIL=
