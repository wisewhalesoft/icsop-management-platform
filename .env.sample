# =============================================================================
# ICSOP 文件管理平台 — 環境變數範本
# =============================================================================
# 使用方式：
#   1. 複製本檔為 .env（同目錄）：  Copy-Item .env.sample .env
#   2. 填入實際值（帳密只留在你本機的 .env，不要貼進對話、不要提交版控）
#   3. 執行盤點腳本，它會自動讀取 .env
#
# ⚠ .env 內含機密，已列入 .gitignore。
#   對應 nfr.md#deployment AC2：DB 連線字串等機密以環境變數注入，不得寫死於
#   image 或版控；AC3：.env.development / .env.staging / .env.production 互不干擾。
# =============================================================================


# -----------------------------------------------------------------------------
# 上游組織/人員/職級 來源資料庫（OQ-E02-01 盤點用）
# -----------------------------------------------------------------------------
# 拓撲：本機 --> UPSTREAM_MSSQL_HOST --> [linked server] . [remote db]
# 實際的組織/人員/職級 view 位於 linked server 上，需以 4 段式命名存取：
#   [UPSTREAM_LINKED_SERVER].[UPSTREAM_REMOTE_DB].[schema].[view]

# 連線端點（我們直接連的那台）
UPSTREAM_MSSQL_HOST=172.20.202.193
UPSTREAM_MSSQL_PORT=1433

# ⚠ 這是「登入 UPSTREAM_MSSQL_HOST 時要開啟的資料庫」，
#   不是下面那個遠端的 UPSTREAM_REMOTE_DB。
#   四支目標 view 位於遠端，一律以 4 段式跨過去存取，所以這裡填什麼不影響結果，
#   只要是這個帳號有權限進入的即可（實測 ZZIPPROD 可用）。
UPSTREAM_MSSQL_DATABASE=ZZIPPROD

# 登入帳密
UPSTREAM_MSSQL_USER=
UPSTREAM_MSSQL_PASSWORD=

# 跨 linked server 到實際 HR 資料庫
UPSTREAM_LINKED_SERVER=APYHFC23
UPSTREAM_REMOTE_DB=HR2

# 連線選項
# TRUST_SERVER_CERT=true 可略過 TLS 憑證驗證（內網自簽憑證常需要）
UPSTREAM_TRUST_SERVER_CERT=true
UPSTREAM_CONNECT_TIMEOUT=15


# -----------------------------------------------------------------------------
# 以下為未來實作階段才會用到，本輪盤點不需填
# -----------------------------------------------------------------------------

# 應用自身資料庫（MSSQL）— 決策：不入容器，dev 亦連外部 MSSQL。
# migration/seed 對此連線執行。與上游 HR MSSQL 為不同資料庫/連線。
# 從容器內連本機 MSSQL 用 host.docker.internal（compose 已設 extra_hosts）。
APP_MSSQL_HOST=host.docker.internal
APP_MSSQL_PORT=1433
APP_MSSQL_DATABASE=icsop
APP_MSSQL_USER=
APP_MSSQL_PASSWORD=
# 內網自簽憑證常需要略過 TLS 驗證
APP_MSSQL_TRUST_SERVER_CERT=true

# RAG 向量庫（pgvector / Postgres，見 OQ-E09-03 定案）— 由 docker compose 容器提供。
# 容器內服務名為 pgvector；本機直連用 localhost。密碼於 compose 亦讀此值。
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=icsop_rag
PGVECTOR_USER=icsop
PGVECTOR_PASSWORD=change-me-pgvector

# 前端呼叫後端之基底網址（compose 內以服務名；本機開發用 localhost）
BACKEND_ORIGIN=http://localhost:3000

# Azure Blob Storage（檔案儲存，storage 介面抽象化）
# AZURE_BLOB_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER=

# Azure AD (Entra ID) OIDC — F001 途徑 A 公司帳號登入
# ICSOP 自行註冊為 Azure AD 應用，走標準 OIDC；使用者已有 AD session 時為靜默 SSO。
# 登入成功後以 id_token 的 email claim（完整含網域、不分大小寫）比對
# VW_HPMUSER.EMAILADDR 且 EMPSTS='A'，詳見 upstream-hr-source-contract.md §12。
# 模式：Web（後端機密用戶端）＋ authorization code flow ＋ PKCE。
# token 全程留在後端，瀏覽器僅持有 httpOnly session cookie。
# 註冊步驟見 docs/setup/azure-ad-app-registration.md
#
# 公司租用戶 ID（非機密，取自既有專案設定）
# AZURE_AD_TENANT_ID=4fc63fd2-84fc-48ac-aa7f-a816efde1f5a
#
# 註冊 app 後填入
# AZURE_AD_CLIENT_ID=
#
# ⚠ 機密。Azure Portal 建立後只顯示一次，且【到期會導致全系統無法登入】，
#   請一併記錄到期日並排提醒。
# AZURE_AD_CLIENT_SECRET=
#
# 必須與 Azure 登記之 redirect URI 逐字一致（含結尾斜線與大小寫）；各環境不同值。
# 回呼進【後端】，因授權碼須由後端以 client secret 兌換，前端不得接觸。
# AZURE_AD_REDIRECT_URI=http://localhost:3000/auth/callback
#
# 註：scopes（openid profile email）對本 app 為固定值、不隨環境變動，
#     故置於程式碼常數而非環境變數，避免與 Azure 端已同意之權限不一致。

# 我方 session JWT 簽章密鑰（＋簽章 OIDC tx cookie）。
# 未設定時後端以 dev 預設密鑰運行並警告；正式環境務必設定強隨機值。
# 產生範例：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_JWT_SECRET=
# Session 閒置逾時固定 30 分鐘（OQ-E01-04），為程式常數，非環境變數。
