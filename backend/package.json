{
  "name": "icsop-backend",
  "version": "0.0.1",
  "description": "ICSOP 文件管理平台 — 後端（NestJS）",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:int": "jest --config test/jest-int.json",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test:mutation": "stryker run",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- -d src/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d src/database/data-source.ts migration:revert",
    "migration:generate": "npm run typeorm -- -d src/database/data-source.ts migration:generate",
    "seed:roles": "ts-node src/database/seed-roles.ts",
    "seed:bootstrap-admin": "ts-node src/database/seed-bootstrap-admin.ts",
    "seed:lifecycle": "ts-node src/database/seed-lifecycle.ts",
    "seed:doc-catalog": "ts-node src/database/seed-document-catalog.ts",
    "sync:once": "ts-node src/org-sync/sync-once.ts",
    "repair:filenames": "ts-node src/database/repair-mojibake-filenames.ts",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "seed:roles:prod": "node dist/database/seed-roles.js",
    "seed:bootstrap-admin:prod": "node dist/database/seed-bootstrap-admin.js",
    "seed:lifecycle:prod": "node dist/database/seed-lifecycle.js",
    "seed:doc-catalog:prod": "node dist/database/seed-document-catalog.js",
    "sync:once:prod": "node dist/org-sync/sync-once.js",
    "repair:filenames:prod": "node dist/database/repair-mojibake-filenames.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/../test/jest-setup-tz.ts"
    ],
    "testEnvironment": "node",
    "maxWorkers": 4
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.7"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.1",
    "@azure/storage-blob": "^12.33.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "mssql": "^12.7.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  }
}
